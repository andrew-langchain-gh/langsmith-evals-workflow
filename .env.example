LANGSMITH_PROJECT="deepagent-travel-planner"
LANGSMITH_TRACING="true"

LANGSMITH_WORKSPACE_ID=""
LANGSMITH_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
TAVILY_API_KEY=""

ANTHROPIC_BASE_URL="https://gateway.smith.langchain.com/anthropic"
ANTHROPIC_CUSTOM_HEADERS=""
OPENAI_BASE_URL="https://gateway.smith.langchain.com/openai/v1"
GOOGLE_GEMINI_BASE_URL="https://gateway.smith.langchain.com/gemini"

# Any init_chat_model "provider:model" id; defaults to Claude Haiku 4.5
TRAVEL_PLANNER_MODEL="anthropic:claude-haiku-4-5-20251001"
# Coordinator prompt version: v1 (flawed, for the eval demo) or v2
TRAVEL_PLANNER_PROMPT_VERSION="v2"
# Model for LLM-as-judge evaluators (a stronger model than the agent's judges more reliably)
EVAL_JUDGE_MODEL="anthropic:claude-sonnet-5"
# Model for the LLM-simulated users in evals/03_simulate_production_traffic.py
SIMULATED_USER_MODEL="anthropic:claude-haiku-4-5-20251001"
